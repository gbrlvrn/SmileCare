PORT=5000
NODE_ENV=development
# MongoDB Atlas connection string (database name: smilecare)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/smilecare?appName=<app>
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<64-byte-hex-secret>
JWT_EXPIRES_IN=1d
# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173
CLINIC_TIMEZONE=Asia/Manila
# Optional, development only: raise the registration/OTP rate limit (default 10 per 15 min)
# AUTH_RATE_LIMIT_MAX=100
# Optional, development only: customize login IP rate limit (default 5 attempts per 60 sec)
# LOGIN_RATE_LIMIT_MAX=5
# LOGIN_RATE_LIMIT_WINDOW_MS=60000
# Used by `npm run seed` to create the first staff (admin) account
SEED_ADMIN_EMAIL=admin@smilecare.com
SEED_ADMIN_PASSWORD=<strong-password>

# Modern HTTP Email Dispatch (Recommended for cloud hosts like Render Free Tier that block outbound SMTP):
# RESEND_API_KEY=re_your_api_key_here
# RESEND_FROM="SmileCare Dental <onboarding@resend.dev>"

# Traditional SMTP Settings (Works locally or on paid hosting):
# EMAIL_SERVICE=gmail
# EMAIL_USER=your-clinic-email@gmail.com
# EMAIL_PASS=your-google-app-password
# EMAIL_FROM="SmileCare Dental" <your-clinic-email@gmail.com>

